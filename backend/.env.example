SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2
# For a physical iOS/Android device on the same Wi-Fi, add your PC's LAN IP
# (find it with `ipconfig`, e.g. 192.168.1.88), and start the server with:
#   python manage.py runserver 0.0.0.0:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ═══════════════════════════════════════════════════════════════
#  PRODUCTION (Render) — leave all of this unset for local dev.
#  Postgres: services are created and wired up by hand in the Render
#  dashboard. Set DATABASE_URL on the backend web service to the
#  "bewosai-db" database's Internal Database URL (Render dashboard →
#  bewosai-db → Connections).
# ═══════════════════════════════════════════════════════════════
# DEBUG=False
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://bewosaiapp.vercel.app
# CSRF_TRUSTED_ORIGINS=https://bewosaiapp.vercel.app
# DATABASE_URL=postgresql://user:pass@host:port/dbname     (Render sets this)
# RENDER_EXTERNAL_HOSTNAME=your-service.onrender.com       (Render sets this)

# ═══════════════════════════════════════════════════════════════
#  FILE STORAGE — optional. Render's disk is ephemeral, so product images /
#  business logos / bill photos uploaded there vanish on every deploy.
#  Leave blank to keep using local disk (fine for local dev).
#  Get this from Cloudinary dashboard → "API Environment variable".
# ═══════════════════════════════════════════════════════════════
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ═══════════════════════════════════════════════════════════════
#  EMAIL SETUP — pick ONE option below
# ═══════════════════════════════════════════════════════════════

# ── Option A: Gmail SMTP (Recommended — no extra account needed) ──────────────
#
#  Step 1: Go to https://myaccount.google.com/security
#  Step 2: Enable "2-Step Verification"
#  Step 3: Search "App passwords" → create one named "Bewosai"
#  Step 4: Copy the 16-character password shown → paste as EMAIL_HOST_PASSWORD
#
EMAIL_HOST_USER=yourname@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# ── Option B: SendGrid (leave blank if using Gmail SMTP) ──────────────────────
#
#  Step 1: Sign up at https://sendgrid.com (free: 100 emails/day)
#  Step 2: Settings → Sender Authentication → Single Sender Verification
#  Step 3: Verify your Gmail address
#  Step 4: Settings → API Keys → Create API Key (Mail Send permission)

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=yourname@gmail.com
DEFAULT_FROM_EMAIL=Bewosai <yourname@gmail.com>

# ═══════════════════════════════════════════════════════════════
#  When NEITHER option is configured, OTPs print to the Django
#  console only (development fallback — no real email sent).
# ═══════════════════════════════════════════════════════════════
